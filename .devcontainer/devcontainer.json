{
  "name": "NebulaX / OrbitGuard",

  // Debian 12 base with Node 18 already installed. Smaller (~1.5 GB vs ~10 GB)
  // and avoids the stale Yarn apt repo in mcr.microsoft.com/devcontainers/universal:2-linux
  // that breaks Docker-in-Docker install (NO_PUBKEY 62D54FD4003F6525).
  "image": "mcr.microsoft.com/devcontainers/javascript-node:18-bookworm",

  // Docker-in-Docker so `docker compose` works for the project's 27 services.
  // sshd so `gh codespace ssh` can connect for remote debugging from a laptop.
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "moby": true,
      "dockerDashComposeVersion": "v2"
    },
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },

  // Forward the ports the project uses; auto-open the dashboard when ready.
  "forwardPorts": [3000, 8000, 5001, 8080, 2222],
  "portsAttributes": {
    "3000": { "label": "Dashboard (Next.js)", "onAutoForward": "openBrowser" },
    "8000": { "label": "Core API (FastAPI)", "onAutoForward": "silent" },
    "5001": { "label": "Vulnerable Ground Station" },
    "8080": { "label": "Vulnerable Web Target" },
    "2222": { "label": "SSH Honeypot" }
  },

  // Ask Codespaces to give us the bigger machine. Cesium needs RAM.
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },

  // Wire NEXT_PUBLIC_API_HOST + CORS_ORIGINS to the codespace's public URLs so
  // browser fetches across *.app.github.dev work. CODESPACE_NAME and
  // GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN are auto-injected by the runtime.
  "remoteEnv": {
    "NEXT_PUBLIC_API_HOST": "https://${localEnv:CODESPACE_NAME}-8000.${localEnv:GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN}",
    "CORS_ORIGINS": "https://${localEnv:CODESPACE_NAME}-3000.${localEnv:GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN}"
  },

  // One-time setup: build shared base, install dashboard deps.
  "postCreateCommand": "bash .devcontainer/post-create.sh",

  // Every time the codespace starts (boot or resume), make sure the backend is up.
  "postStartCommand": "bash .devcontainer/post-start.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-docker",
        "ms-python.python",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
